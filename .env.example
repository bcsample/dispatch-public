# Copy this file to .env (gitignored -- it's yours, it never gets committed)
# and fill in whatever you actually want to use. Every line here is OPTIONAL:
# Dispatch runs with none of these set, using Google News RSS (free, no key)
# for news and skipping any feature whose key is missing.

# NewsAPI.ai (https://newsapi.ai) -- optional extra news source on top of the
# free Google News RSS feed. Leave blank to run on Google News RSS alone.
NEWSAPI_KEY=

# NASA FIRMS (https://firms.modaps.eosdis.nasa.gov/api/map_key/) -- free,
# instant signup. Lights up the wildfire layer in the World Delta panel.
# Leave blank to skip that feed entirely.
NASA_FIRMS_MAP_KEY=

# OpenSky Network (https://opensky-network.org) -- optional, higher-rate-limit
# flight data if you register a free client ID/secret. The Skies panel works
# without this via the free adsb.fi API; these just raise the request ceiling.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Local Ollama, if you want LLM-based headline curation/ranking (optional --
# without it, headlines are shown unranked/unfiltered by relevance).
# Default assumes Ollama running locally on its standard port.
OLLAMA_HOST=http://127.0.0.1:11434
